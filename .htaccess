<IfModule mod_rewrite.c>
    RewriteEngine On

    # Allow ACME Challenge for SSL verification
    RewriteRule ^\.well-known/ - [L]

    # Block access to all other hidden files and directories (.env, .git, etc.)
    RewriteRule ^\.(.*)$ - [F,L]

    # Block direct access to sensitive framework directories
    RewriteRule ^(app|bootstrap|config|database|resources|routes|storage|tests|vendor)(/.*)?$ - [F,L]

    # Rewrite all traffic to public/
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
